{
  "name": "strativra-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Strativra Tracking Audit Engine: core, hosted worker, local CLI, report renderer.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-reporter=spec \"src/**/*.test.ts\"",
    "worker": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/worker/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@duckduckgo/autoconsent": "^16.60.0",
    "playwright-core": "^1.64.1"
  }
}
